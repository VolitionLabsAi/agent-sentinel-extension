{
  "name": "agent-sentinel",
  "displayName": "Agent Sentinel",
  "description": "Real-time AI agent monitoring — Error Lens + GitLens for AI agent safety",
  "version": "0.0.1",
  "publisher": "volition",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/VolitionLabsAi/agent-sentinel-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "ai",
    "sentinel",
    "monitoring",
    "safety",
    "agent"
  ],
  "activationEvents": [
    "workspaceContains:**/.volition/sentinel/sentinel.config.json",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "**/sentinel.config.json",
        "url": "./schemas/sentinel.config.schema.json"
      }
    ],
    "commands": [
      {
        "command": "sentinel.start",
        "title": "Sentinel: Start Monitoring"
      },
      {
        "command": "sentinel.stop",
        "title": "Sentinel: Stop Monitoring"
      },
      {
        "command": "sentinel.status",
        "title": "Sentinel: Show Status"
      },
      {
        "command": "sentinel.openLiveFeed",
        "title": "Sentinel: Open Live Feed"
      },
      {
        "command": "sentinel.runHealthCheck",
        "title": "Sentinel: Run Health Check"
      },
      {
        "command": "sentinel.focusSession",
        "title": "Sentinel: Focus Session"
      },
      {
        "command": "sentinel.setViewMode",
        "title": "Sentinel: Set View Mode",
        "icon": "$(filter)"
      },
      {
        "command": "sentinel.showSessionHealth",
        "title": "Sentinel: Show Session Health"
      },
      {
        "command": "sentinel.navigateToSession",
        "title": "Sentinel: Navigate to Session"
      },
      {
        "command": "sentinel.init",
        "title": "Sentinel: Initialize Configuration"
      },
      {
        "command": "sentinel.openSettings",
        "title": "Sentinel: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "sentinel.toggleEvalRule",
        "title": "Sentinel: Toggle Eval Rule"
      },
      {
        "command": "sentinel.inspectDynamicEval",
        "title": "Sentinel: Inspect Dynamic Eval"
      },
      {
        "command": "sentinel.viewObservationCard",
        "title": "Sentinel: View Observation Details"
      },
      {
        "command": "sentinel.loadMoreHistory",
        "title": "Sentinel: Load More History"
      },
      {
        "command": "sentinel.promoteEval",
        "title": "Sentinel: Promote Dynamic Eval",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sentinel.openSentinelChat",
        "title": "Sentinel: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sentinel.createEval",
        "title": "Sentinel: Create New Eval",
        "icon": "$(add)"
      },
      {
        "command": "sentinel.editEval",
        "title": "Sentinel: Edit Eval"
      },
      {
        "command": "sentinel.steerSentinel",
        "title": "Sentinel: Tell Sentinel...",
        "icon": "$(megaphone)"
      },
      {
        "command": "sentinel.selectHarness",
        "title": "Sentinel: Select Harness",
        "icon": "$(server-process)"
      },
      {
        "command": "sentinel.exportEval",
        "title": "Sentinel: Export Eval",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "sentinel.importEval",
        "title": "Sentinel: Import Eval",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "viewContainer/title": [
        {
          "command": "sentinel.openSettings",
          "when": "viewContainer == sentinel",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "sentinel.setViewMode",
          "when": "view == sentinel.about",
          "group": "navigation"
        },
        {
          "command": "sentinel.openSentinelChat",
          "when": "view == sentinel.liveFeed || view == sentinel.conversationPanel",
          "group": "navigation"
        },
        {
          "command": "sentinel.createEval",
          "when": "view == sentinel.evalRules",
          "group": "navigation"
        },
        {
          "command": "sentinel.importEval",
          "when": "view == sentinel.evalRules",
          "group": "navigation"
        },
        {
          "command": "sentinel.steerSentinel",
          "when": "view == sentinel.conversationPanel",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sentinel.inspectDynamicEval",
          "when": "viewItem == evalRule.dynamic",
          "group": "inline@1"
        },
        {
          "command": "sentinel.promoteEval",
          "when": "viewItem == evalRule.dynamic",
          "group": "inline@2"
        },
        {
          "command": "sentinel.editEval",
          "when": "viewItem == evalRule.enabled || viewItem == evalRule.disabled",
          "group": "1_edit@1"
        },
        {
          "command": "sentinel.editEval",
          "when": "viewItem == evalRule.dynamic",
          "group": "1_edit@1"
        },
        {
          "command": "sentinel.exportEval",
          "when": "viewItem == evalRule.enabled || viewItem == evalRule.disabled",
          "group": "2_share@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sentinel",
          "title": "Agent Sentinel",
          "icon": "media/icons/sentinel-activity.svg"
        }
      ]
    },
    "views": {
      "sentinel": [
        {
          "id": "sentinel.about",
          "name": "Sentinel",
          "type": "webview",
          "visibility": "visible"
        },
        {
          "id": "sentinel.liveFeed",
          "name": "Live Feed"
        },
        {
          "id": "sentinel.sessionHealth",
          "name": "Session Health",
          "type": "webview"
        },
        {
          "id": "sentinel.evalRules",
          "name": "Eval Rules"
        },
        {
          "id": "sentinel.conversationPanel",
          "name": "Sentinel Chat",
          "type": "webview"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "sentinel-setup",
        "title": "Get Started with Agent Sentinel",
        "description": "Set up real-time AI agent monitoring in your workspace.",
        "steps": [
          {
            "id": "what-is-sentinel",
            "title": "What is Agent Sentinel?",
            "description": "Agent Sentinel monitors AI agent activity in real time, surfacing safety observations like Error Lens does for compiler diagnostics.\n\n[Learn more](https://github.com/volition/agent-sentinel#readme)",
            "media": {
              "image": "media/walkthrough/what-is-sentinel.png",
              "altText": "Agent Sentinel overview"
            }
          },
          {
            "id": "configure-workspace",
            "title": "Configure your workspace",
            "description": "Initialize a Sentinel configuration in your project to start capturing agent observations.\n\n[Initialize Config](command:sentinel.init)",
            "media": {
              "image": "media/walkthrough/configure-workspace.png",
              "altText": "Configure workspace"
            },
            "completionEvents": [
              "onContext:sentinel.configPresent"
            ]
          },
          {
            "id": "start-monitoring",
            "title": "Start monitoring",
            "description": "Begin monitoring AI agent sessions in your workspace.\n\n[Start Monitoring](command:sentinel.start)",
            "media": {
              "image": "media/walkthrough/start-monitoring.png",
              "altText": "Start monitoring"
            },
            "completionEvents": [
              "onContext:sentinel.running"
            ]
          },
          {
            "id": "first-observation",
            "title": "See your first observation",
            "description": "Once an agent session is active, Sentinel will capture observations automatically. This step completes when your first observation appears.",
            "media": {
              "image": "media/walkthrough/first-observation.png",
              "altText": "First observation"
            },
            "completionEvents": [
              "onContext:sentinel.firstObservation"
            ]
          },
          {
            "id": "explore-live-feed",
            "title": "Explore the Live Feed",
            "description": "Open the Sentinel sidebar to browse observations in real time.\n\n[Open Live Feed](command:sentinel.openLiveFeed)",
            "media": {
              "image": "media/walkthrough/explore-live-feed.png",
              "altText": "Live Feed sidebar"
            },
            "completionEvents": [
              "onCommand:sentinel.openLiveFeed"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "mocha --require src/test/vscode-mock.js --ui tdd --timeout 10000 'out/test/suite/**/*.test.js'",
    "test:vscode": "tsc -p tsconfig.test.json && npm run build && vscode-test",
    "package": "npx @vscode/vsce package --allow-missing-repository",
    "docs:dev": "cd docs-site && npx vitepress dev",
    "docs:build": "cd docs-site && npx vitepress build",
    "docs:preview": "cd docs-site && npx vitepress preview"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.4",
    "eslint": "^8.57.0",
    "glob": "^13.0.6",
    "mocha": "^11.3.0",
    "prettier": "^3.0.0",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.5.0"
  }
}
